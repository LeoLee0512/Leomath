# PostgreSQL connection string. Docker Compose sets this automatically.
DATABASE_URL=postgres://leomath:leomath@localhost:5432/leomath
# Public origin: absolute links in metadata, HSTS, and the host trusted behind the reverse proxy.
SITE_URL=https://leomath.cn
# ICP filing number shown in the footer, e.g. 京ICP备12345678号-1. Leave empty until the filing is approved.
ICP_NUMBER=
# Content-Security-Policy starts as report-only; violations are logged as "[csp] ..." by the web container.
# Set to 1 and restart once the log stays clean.
CSP_ENFORCE=
