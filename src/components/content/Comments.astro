---
/**
 * Discussion under a concept, experiment or software page, plus the feedback address.
 * Rendered per request; posting and deleting are plain form posts (addComment / deleteComment actions),
 * after which the page reloads at #comments with the new list.
 */
import { actions } from "astro:actions";
import { getDictionary } from "@/i18n/dictionaries";
import { hasDatabase } from "@/lib/db";
import { listComments, isAdmin, COMMENT_MAX_LENGTH, type CommentTargetType } from "@/lib/comments";
import { authorLabel, formatCommentDate } from "@/lib/comments-format";
import { richHtml } from "@/lib/rich";
import { FEEDBACK_EMAIL } from "@/content/site";

interface Props {
  type: CommentTargetType;
  slug: string;
}
const { type, slug } = Astro.props;
const locale = Astro.locals.locale;
const user = Astro.locals.user;
const t = getDictionary(locale);
const tc = t.comments;
const path = Astro.url.pathname;
const comments = hasDatabase() ? await listComments({ type, slug }).catch(() => []) : [];
const admin = isAdmin(user);
const posted = Astro.getActionResult(actions.addComment);
const failed = posted?.data && !posted.data.ok ? posted.data : undefined;
---
<section id="comments" class="mt-16 border-t border-rule pt-8 scroll-mt-24">
  <h2 class="display text-2xl font-semibold">{tc.title}</h2>
  <p class="mt-2 text-sm text-muted">{tc.feedback} <a href={`mailto:${FEEDBACK_EMAIL}`} class="text-leo hover:underline mono">{FEEDBACK_EMAIL}</a></p>

  {comments.length === 0 ? (
    <p class="mt-6 text-sm text-ink-2">{tc.empty}</p>
  ) : (
    <ol class="mt-6 space-y-5">
      {comments.map((c) => (
        <li class="border border-rule bg-paper p-4 md:p-5">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm">
            <span class="font-medium text-ink">{authorLabel(c.author.displayName, c.author.email)}</span>
            <time datetime={c.createdAt.toISOString()} class="mono text-xs text-muted">{formatCommentDate(c.createdAt, locale)}</time>
            {(user?.id === c.userId || admin) && (
              <form method="POST" action={actions.deleteComment} class="ml-auto">
                <input type="hidden" name="locale" value={locale} />
                <input type="hidden" name="id" value={c.id} />
                <input type="hidden" name="path" value={path} />
                <button class="text-xs text-muted hover:text-e1">{tc.delete}</button>
              </form>
            )}
          </div>
          <div class="mt-2 text-[0.95rem] leading-relaxed whitespace-pre-wrap prose-math" set:html={richHtml(c.body)} />
        </li>
      ))}
    </ol>
  )}

  {!hasDatabase() ? null : user ? (
    <form method="POST" action={actions.addComment} class="mt-6" data-comment-form>
      <input type="hidden" name="locale" value={locale} />
      <input type="hidden" name="type" value={type} />
      <input type="hidden" name="slug" value={slug} />
      <input type="hidden" name="path" value={path} />
      <textarea name="body" required maxlength={COMMENT_MAX_LENGTH} rows="4" placeholder={tc.placeholder} aria-label={tc.title} class="field w-full resize-y leading-relaxed">{failed?.body ?? ""}</textarea>
      <div class="mt-2 flex flex-wrap items-center gap-3 text-sm">
        <button class="btn btn-primary btn-small" data-posting={tc.posting}>{tc.submit}</button>
        <span class="text-muted">{tc.hint}</span>
        {failed && <span class="text-e1" role="alert">{failed.error}</span>}
      </div>
    </form>
  ) : (
    <p class="mt-6 text-sm text-muted">
      <a href={`/${locale}/login?next=${encodeURIComponent(path)}`} class="text-leo hover:underline">{t.nav.login}</a>{tc.loginToComment}
    </p>
  )}
</section>

<script>
  // A second click while the post is on its way would post the comment twice.
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-comment-form]")) {
    form.addEventListener("submit", () => {
      const button = form.querySelector<HTMLButtonElement>("button[data-posting]")!;
      queueMicrotask(() => {
        button.disabled = true;
        button.textContent = button.dataset.posting!;
      });
    });
  }
</script>
