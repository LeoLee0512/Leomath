---
/**
 * Site header. Everything here is plain HTML; three small scripts add the theme toggle, the phone menu and
 * a language switch that keeps the query and anchor (e.g. an experiment's settings).
 */
import { getDictionary } from "@/i18n/dictionaries";
import { otherLocale, switchLocalePath } from "@/i18n/config";

const locale = Astro.locals.locale;
const user = Astro.locals.user;
const t = getDictionary(locale);
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const items = [
  { href: `/${locale}/learn`, label: t.nav.learn },
  { href: `/${locale}/explore`, label: t.nav.explore },
  { href: `/${locale}/problems`, label: t.nav.problems },
  { href: `/${locale}/tools`, label: t.nav.tools },
  { href: `/${locale}/software`, label: t.nav.software },
  { href: `/${locale}/about`, label: t.nav.about },
].map((item) => ({ ...item, current: pathname === item.href || pathname.startsWith(`${item.href}/`) }));
const target = otherLocale(locale);
const switchHref = switchLocalePath(pathname, target);
const iconButton = "inline-flex h-8 w-8 items-center justify-center rounded-full text-ink-2 hover:text-ink hover:bg-paper-2";
---
<header class="sticky top-0 z-40 bg-paper/85 backdrop-blur border-b border-rule">
  <div class="container relative flex h-14 items-center gap-6">
    <a href={`/${locale}`} class="display text-lg font-semibold tracking-tight">Leo<span class="text-leo">Math</span></a>
    <nav class="hidden md:flex items-center gap-5 text-sm text-ink-2" aria-label={t.nav.menu}>
      {items.map((item) => (
        <a href={item.href} aria-current={item.current ? "page" : undefined} class={item.current ? "text-ink font-medium" : "hover:text-ink"}>{item.label}</a>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-1">
      <a href={`/${locale}/learn#search`} aria-label={t.nav.search} title={t.nav.search} class={iconButton}>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4">
          <circle cx="7" cy="7" r="4.5"></circle>
          <path d="M10.5 10.5 L14 14"></path>
        </svg>
      </a>
      <button type="button" data-theme-toggle aria-label={t.nav.theme} aria-pressed="false" title={t.nav.theme} class={iconButton}>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
          <path d="M8 1.5 A6.5 6.5 0 0 1 8 14.5 Z" fill="currentColor"></path>
        </svg>
      </button>
      <a href={switchHref + Astro.url.search} data-locale-switch hreflang={target} lang={target === "zh" ? "zh-CN" : "en"} class="text-sm text-ink-2 hover:text-ink px-2 py-1 rounded whitespace-nowrap">{t.nav.language}</a>
      <a href={`/${locale}/${user ? "account" : "login"}`} class="text-sm text-ink-2 hover:text-ink px-2 py-1 whitespace-nowrap">{user ? t.nav.account : t.nav.login}</a>
      <div class="md:hidden" data-mobile-menu>
        <button type="button" aria-label={t.nav.menu} aria-expanded="false" aria-controls="mobile-menu" class={iconButton}>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
            <path data-icon="open" d="M2.5 4.5h11M2.5 8h11M2.5 11.5h11"></path>
            <path data-icon="close" d="M3.5 3.5l9 9M12.5 3.5l-9 9" display="none"></path>
          </svg>
        </button>
        <!-- Always present (hidden when closed), so aria-controls always points at something. -->
        <div id="mobile-menu" hidden class="absolute inset-x-0 top-14 border-b border-rule bg-paper shadow-sm">
          <nav class="container py-2" aria-label={t.nav.menu}>
            <ul>
              {items.map((item) => (
                <li class="border-b border-rule last:border-b-0">
                  <a href={item.href} aria-current={item.current ? "page" : undefined} class={`block py-2.5 text-[0.95rem] ${item.current ? "text-leo" : "text-ink-2 hover:text-ink"}`}>{item.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const KEY = "leomath_theme";
  const html = document.documentElement;

  // Theme: the class is set before paint by the layout's inline script; the button toggles and remembers it.
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    const sync = () => button.setAttribute("aria-pressed", String(html.classList.contains("dark")));
    sync();
    button.addEventListener("click", () => {
      const dark = !html.classList.contains("dark");
      html.classList.toggle("dark", dark);
      try {
        localStorage.setItem(KEY, dark ? "dark" : "light");
      } catch {}
      sync();
    });
  }

  // Switching language keeps the current query and anchor, which may have changed since the page loaded.
  for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-locale-switch]")) {
    link.addEventListener("click", (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      const target = new URL(link.href);
      location.href = target.pathname + location.search + location.hash;
    });
  }

  // Phone menu: Escape closes it and returns focus to the button; a tap outside closes it.
  for (const wrap of document.querySelectorAll<HTMLElement>("[data-mobile-menu]")) {
    const button = wrap.querySelector("button")!;
    const panel = wrap.querySelector<HTMLElement>("#mobile-menu")!;
    const set = (open: boolean) => {
      panel.hidden = !open;
      button.setAttribute("aria-expanded", String(open));
      wrap.querySelector<SVGElement>('[data-icon="open"]')!.setAttribute("display", open ? "none" : "inline");
      wrap.querySelector<SVGElement>('[data-icon="close"]')!.setAttribute("display", open ? "inline" : "none");
    };
    button.addEventListener("click", () => set(panel.hidden));
    window.addEventListener("keydown", (e) => {
      if (e.key !== "Escape" || panel.hidden) return;
      set(false);
      button.focus();
    });
    window.addEventListener("pointerdown", (e) => {
      if (!panel.hidden && !wrap.contains(e.target as Node)) set(false);
    });
  }
</script>
