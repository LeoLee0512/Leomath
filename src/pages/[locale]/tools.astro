---
import Base from "@/layouts/Base.astro";
import { FormulaEditor } from "@/components/tools/FormulaEditor";
import { Plotter } from "@/components/tools/Plotter";
import { MatrixTool } from "@/components/tools/MatrixTool";
import { getDictionary } from "@/i18n/dictionaries";
import { concepts, type Tool } from "@/content/graph";
import { pageMeta } from "@/lib/seo";

const locale = Astro.locals.locale;
const t = getDictionary(locale);
const label = `${t.tools.related}${t.common.colon}`;
const related = (id: Tool["id"]) => concepts.filter((c) => c.status === "published" && c.tools?.includes(id));
const meta = pageMeta(locale, "/tools", t.tagline, { title: t.tools.title, description: t.tools.subtitle });
---
<Base meta={meta}>
  <div class="container py-14">
    <h1 class="display text-4xl font-semibold">{t.tools.title}</h1>
    <p class="mt-3 text-ink-2 max-w-2xl">{t.tools.subtitle}</p>
    <nav class="mt-6 flex flex-wrap gap-4 text-sm">
      <a href="#formula" class="text-leo hover:underline">{t.tools.formula}</a>
      <a href="#plot" class="text-leo hover:underline">{t.tools.plot}</a>
      <a href="#matrix" class="text-leo hover:underline">{t.tools.matrix}</a>
    </nav>
    <div class="mt-10 space-y-10">
      <div>
        <FormulaEditor client:visible locale={locale} />
        {related("formula").length > 0 && (
          <p class="mt-3 text-sm text-muted">{label}{related("formula").map((c, i) => <span>{i > 0 && " · "}<a href={`/${locale}/concepts/${c.slug}`} class="text-leo hover:underline">{c.title[locale]}</a></span>)}</p>
        )}
      </div>
      <div>
        <Plotter client:visible locale={locale} />
        {related("plot").length > 0 && (
          <p class="mt-3 text-sm text-muted">{label}{related("plot").map((c, i) => <span>{i > 0 && " · "}<a href={`/${locale}/concepts/${c.slug}`} class="text-leo hover:underline">{c.title[locale]}</a></span>)}</p>
        )}
      </div>
      <div>
        <MatrixTool client:visible locale={locale} />
        {related("matrix").length > 0 && (
          <p class="mt-3 text-sm text-muted">{label}{related("matrix").map((c, i) => <span>{i > 0 && " · "}<a href={`/${locale}/concepts/${c.slug}`} class="text-leo hover:underline">{c.title[locale]}</a></span>)}</p>
        )}
      </div>
    </div>
  </div>
</Base>
