---
import Base from "@/layouts/Base.astro";
import Formula from "@/components/content/Formula.astro";
import PathCard from "@/components/cards/PathCard.astro";
import SoftwareCard from "@/components/cards/SoftwareCard.astro";
import LinearTransformIsland from "@/components/experiments/islands/LinearTransform";
import ExponentialDerivativeIsland from "@/components/experiments/islands/ExponentialDerivative";
import { KnowledgeTree } from "@/components/KnowledgeTree";
import { getDictionary } from "@/i18n/dictionaries";
import { paths, experiments, publishedConcepts } from "@/content/graph";
import { exercises } from "@/content/exercises";
import { software } from "@/content/software";
import { formulasFor } from "@/content/experiment-tex";
import { VERSION } from "@/content/site";
import { pathStats } from "@/lib/paths";
import { readingMinutesMap } from "@/lib/reading";
import { tex } from "@/lib/tex";
import { pageMeta } from "@/lib/seo";

const locale = Astro.locals.locale;
const t = getDictionary(locale);
const minutes = await readingMinutesMap(publishedConcepts().map((c) => c.slug), locale);
const stats = await Promise.all(paths.map((p) => pathStats(p, locale)));
// Unreleased software stays on the software page; the home page is for learning.
const released = software.filter((s) => s.status !== "coming-soon");
const meta = pageMeta(locale, "", t.tagline, { description: t.home.heroSubtitle });
---
<Base meta={meta}>
    {/* 1. Hero: a quiet mathematical canvas with a real object to play with. */}
    <section class="relative overflow-hidden">
      <svg class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true">
    <defs>
      <pattern id="hero-grid" width="48" height="48" patternUnits="userSpaceOnUse">
        <path d="M 48 0 L 0 0 0 48" fill="none" stroke="var(--grid)" stroke-width="1" />
      </pattern>
      <linearGradient id="hero-fade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--paper)" stop-opacity="0.2" />
        <stop offset="0.75" stop-color="var(--paper)" stop-opacity="0.55" />
        <stop offset="1" stop-color="var(--paper)" stop-opacity="1" />
      </linearGradient>
    </defs>
    <rect width="100%" height="100%" fill="url(#hero-grid)" />
    <rect width="100%" height="100%" fill="url(#hero-fade)" />
  </svg>
      <div class="container relative grid gap-10 lg:grid-cols-[1.05fr_1fr] items-center py-14 md:py-20 lg:py-24">
        <div class="max-w-xl min-w-0">
          <h1 class="display text-[2.4rem] leading-[1.15] md:text-[3.2rem] font-semibold">{t.home.heroTitle}</h1>
          <p class="mt-6 text-lg text-ink-2 leading-relaxed">{t.home.heroSubtitle}</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#paths" class="btn btn-primary">{t.home.ctaExplore}</a>
            <a href={`/${locale}/concepts/derivative`} class="btn btn-ghost">{t.home.ctaTry}</a>
          </div>
          <p class="mt-5 text-sm text-muted">
            {t.paths.stats(paths.length, publishedConcepts().length, experiments.length, exercises.length)}
            <span class="mx-1.5">·</span>
            {t.paths.free}
          </p>
          <div class="mt-14 hidden lg:block">
            <p class="display text-xl text-ink">{t.home.heroCaptionA}</p>
            <p class="display text-xl text-ink-2 mt-1">{t.home.heroCaptionB}</p>
            <a href={`/${locale}/concepts/linear-maps`} class="mt-4 inline-block text-sm text-leo hover:underline">{t.home.heroLink}</a>
          </div>
        </div>
        <div class="min-w-0">
          <LinearTransformIsland client:load slug="linear-transform" locale={locale} formulas={{}} compact />
          <p class="mt-3 text-sm text-muted">↑ {t.home.heroDemoNote}</p>
          <div class="mt-6 lg:hidden">
            <p class="display text-lg text-ink">{t.home.heroCaptionA}</p>
            <p class="display text-lg text-ink-2">{t.home.heroCaptionB}</p>
            <a href={`/${locale}/concepts/linear-maps`} class="mt-2 inline-block text-sm text-leo hover:underline">{t.home.heroLink}</a>
          </div>
        </div>
      </div>
    </section>

    {/* 2. Where to start: every path with who it is for, what it needs and what it gives. */}
    <section id="paths" class="section hairline scroll-mt-16">
      <div class="container">
        <div class="max-w-2xl">
          <h2 class="display text-3xl md:text-4xl font-semibold">{t.home.pathsTitle}</h2>
          <p class="mt-4 text-ink-2 leading-relaxed">{t.home.pathsSubtitle}</p>
          <p class="mt-3 text-sm text-muted leading-relaxed">{t.paths.choose}</p>
        </div>
        <div class="mt-10 grid gap-px bg-rule md:grid-cols-2 border border-rule">
          {paths.map((p, i) => <PathCard p={p} stats={stats[i]} />)}
        </div>
      </div>
    </section>

    {/* 3. The knowledge tree: mathematics is connected. */}
    <section class="section hairline">
      <div class="container">
        <div class="max-w-2xl">
          <h2 class="display text-3xl md:text-4xl font-semibold">{t.home.treeTitle}</h2>
          <p class="mt-4 text-ink-2 leading-relaxed">{t.home.treeSubtitle}</p>
        </div>
        <div class="mt-10">
          <KnowledgeTree client:visible locale={locale} minutes={minutes} />
        </div>
      </div>
    </section>

    {/* 4. How LeoMath teaches: one real example. */}
    <section class="section hairline">
      <div class="container grid gap-10 lg:grid-cols-2 lg:items-start">
        <div>
          <p class="eyebrow">{t.home.methodChainLead}</p>
          <h2 class="display text-3xl md:text-4xl font-semibold mt-3">{t.home.methodTitle}</h2>
          <p class="mt-4 text-ink-2 leading-relaxed">{t.home.methodLead}</p>
          <div class="mt-6 prose-math">
            <Formula display tex={"f(x)=a^{x},\\qquad \\frac{f(x+h)-f(x)}{h}=a^{x}\\cdot\\frac{a^{h}-1}{h}"} />
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-2 text-sm">
            {t.home.methodChain.map((step, i) => (
              <span class="inline-flex items-center gap-2">
                <span class="border border-ink-2 px-2 py-0.5 rounded-[3px]">{step}</span>
                {i < t.home.methodChain.length - 1 && <span class="text-muted">→</span>}
              </span>
            ))}
          </div>
          <div class="mt-8 flex items-center gap-3 text-lg display">
            <span>{t.home.methodIntuition}</span>
            <span class="text-muted">⟶</span>
            <span class="border border-ink px-2 py-0.5 rounded-[3px] font-semibold">{t.home.methodRigor}</span>
          </div>
          <p class="mt-3 text-ink-2 leading-relaxed max-w-md">{t.home.methodBoth}</p>
          <a href={`/${locale}/concepts/derivative`} class="mt-5 inline-block text-sm text-leo hover:underline">{t.home.methodLink}</a>
        </div>
        <ExponentialDerivativeIsland client:visible slug="exponential-derivative" locale={locale} formulas={{ quotient: tex(formulasFor("exponential-derivative", locale).quotient) }} compact />
      </div>
    </section>

    {/* 5. Leo Lab */}
    <section class="section hairline">
      <div class="container">
        <div class="max-w-2xl">
          <h2 class="display text-3xl md:text-4xl font-semibold">{t.home.labTitle}</h2>
          <p class="mt-4 text-ink-2 leading-relaxed">{t.home.labSubtitle}</p>
        </div>
        <div class="mt-10 grid gap-8 md:grid-cols-3">
          {[
            { title: t.home.labExperiments, desc: t.home.labExperimentsDesc, formula: "\\dot{x}=\\sigma(y-x)", href: `/${locale}/explore`, live: true },
            { title: t.home.labComputing, desc: t.home.labComputingDesc, formula: "\\|y_n-y(t_n)\\|=O(h^4)", href: `/${locale}/explore/ode-explorer`, live: true },
            { title: t.home.labDevlog, desc: t.home.labDevlogDesc, formula: `\\text{v}${VERSION}`, href: `/${locale}/about`, live: false },
          ].map((card) => (
            <a href={card.href} class="group block border-t border-ink-2 pt-5">
              <div class="text-muted text-lg h-8"><Formula tex={card.formula} /></div>
              <h3 class="display text-xl font-semibold mt-3 group-hover:text-leo transition-colors">{card.title}</h3>
              <p class="mt-2 text-sm text-ink-2 leading-relaxed">{card.desc}</p>
              {!card.live && <p class="mt-3 text-xs text-muted">{t.home.labComing}</p>}
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* 6. Leo Software */}
    <section class="section hairline">
      <div class="container">
        <div class="max-w-2xl">
          <h2 class="display text-3xl md:text-4xl font-semibold">{t.home.softwareTitle}</h2>
          <p class="mt-4 text-ink-2 leading-relaxed">{t.home.softwareSubtitle}</p>
        </div>
        <div class="mt-10 grid gap-4 md:grid-cols-3">
          {released.map((s) => (
            <SoftwareCard s={s} learnLabel={t.home.softwareLearn} />
          ))}
        </div>
      </div>
    </section>

</Base>
