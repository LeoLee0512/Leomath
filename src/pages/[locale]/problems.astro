---
import { actions } from "astro:actions";
import Base from "@/layouts/Base.astro";
import ExerciseCard from "@/components/exercises/ExerciseCard.astro";
import { getDictionary } from "@/i18n/dictionaries";
import { paths, getConcept } from "@/content/graph";
import { exercisesForConcept } from "@/content/exercises";
import { getExerciseSummary } from "@/lib/progress";
import { pageMeta } from "@/lib/seo";
import type { AnswerResult } from "@/actions";

const locale = Astro.locals.locale;
const t = getDictionary(locale);
const user = Astro.locals.user;
const summary: Record<string, { attempts: number; solved: boolean }> = user ? await getExerciseSummary(user.id).catch(() => ({})) : {};
const answer = Astro.getActionResult(actions.checkAnswer)?.data as AnswerResult | undefined;
// Exercises are numbered straight through the page.
let n = 0;
const sections = paths.map((p) => ({
  p,
  groups: p.concepts.map((slug) => ({ slug, exs: exercisesForConcept(slug).map((e) => ({ e, index: ++n })) })),
}));
const meta = pageMeta(locale, "/problems", t.tagline, { title: t.problems.title, description: t.problems.subtitle });
---
<Base meta={meta}>
  <div class="container py-14">
    <h1 class="display text-4xl font-semibold">{t.problems.title}</h1>
    <p class="mt-3 text-ink-2 max-w-2xl">{t.problems.subtitle}</p>
    <div class="mt-12 space-y-16 max-w-3xl">
      {sections.map(({ p, groups }) => (
        <section>
          <h2 class="display text-2xl font-semibold">{p.title[locale]}</h2>
          {groups.map(({ slug, exs }) => (
            <div class="mt-8">
              <h3 class="text-sm eyebrow mb-4"><a href={`/${locale}/concepts/${slug}`} class="hover:text-ink">{getConcept(slug)!.title[locale]}</a></h3>
              <div class="space-y-4">
                {exs.map(({ e, index }) => <ExerciseCard exercise={e} index={index} summary={summary[e.id]} result={answer?.exercise === e.id ? answer : undefined} />)}
              </div>
            </div>
          ))}
        </section>
      ))}
    </div>
  </div>
</Base>
