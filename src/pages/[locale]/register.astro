---
import { actions } from "astro:actions";
import Base from "@/layouts/Base.astro";
import AuthForm from "@/components/account/AuthForm.astro";
import { getDictionary } from "@/i18n/dictionaries";
import { pageMeta } from "@/lib/seo";
import { redirectAfterForms } from "@/lib/forms";

const redirect = redirectAfterForms(Astro, [actions.register]);
if (redirect) return redirect;
const locale = Astro.locals.locale;
if (Astro.locals.user) return Astro.redirect(`/${locale}/account`);
const next = Astro.url.searchParams.get("next") ?? undefined;
const t = getDictionary(locale);
const meta = pageMeta(locale, "/register", t.tagline, { title: t.auth.registerTitle, description: t.tagline, noindex: true });
---
<Base meta={meta}>
  <div class="container py-16">
    <div class="mx-auto max-w-sm">
      <h1 class="display text-3xl font-semibold mb-8">{t.auth.registerTitle}</h1>
      <ul class="mb-8 -mt-4 space-y-1.5 text-sm text-ink-2">
        {t.paths.loginBullets.map((b) => <li class="flex gap-2"><span class="text-e2" aria-hidden="true">✓</span>{b}</li>)}
        <li class="pt-1 text-xs text-muted">{t.paths.loginNote}</li>
      </ul>
      <AuthForm mode="register" next={next} />
    </div>
  </div>
</Base>
