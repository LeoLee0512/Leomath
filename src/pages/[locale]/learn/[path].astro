---
import Base from "@/layouts/Base.astro";
import CreditLine from "@/components/content/CreditLine.astro";
import { KnowledgeTree } from "@/components/KnowledgeTree";
import { getDictionary } from "@/i18n/dictionaries";
import { getPath, getConcept, experimentsForConcept, nextInPath } from "@/content/graph";
import { exercisesForConcept } from "@/content/exercises";
import { getProgress } from "@/lib/progress";
import { pathStats } from "@/lib/paths";
import { pageMeta } from "@/lib/seo";

const locale = Astro.locals.locale;
const p = getPath(Astro.params.path ?? "");
if (!p) return Astro.rewrite("/404");
const t = getDictionary(locale);
const user = Astro.locals.user;
const done: Record<string, string> = user ? await getProgress(user.id).catch(() => ({})) : {};
const stats = await pathStats(p, locale);
const minutes = stats.perConcept;
const next = nextInPath(p, done);
const finished = next.done === p.concepts.length;
const meta = pageMeta(locale, `/learn/${p.slug}`, t.tagline, { title: p.title[locale], description: p.subtitle[locale] });
---
<Base meta={meta}>
    <div class="container py-14">
      <p class="eyebrow"><a href={`/${locale}/learn`} class="hover:text-ink">{t.learn.title}</a></p>
      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2">
        <h1 class="display text-4xl font-semibold">{p.title[locale]}</h1>
        <span class={`text-xs rounded-[3px] px-1.5 py-0.5 border ${p.level === "intro" ? "text-e2 border-e2/40" : "text-leo border-leo/40"}`}>{t.paths.level[p.level]}</span>
      </div>
      <p class="mt-3 text-ink-2 text-lg">{p.subtitle[locale]}</p>
      <p class="mt-2 text-xs mono text-muted">
        {t.paths.counts(stats.concepts, stats.experiments, stats.exercises)} · {t.paths.minutes(stats.minutes)}
        {stats.updated && <> · {t.paths.updated(stats.updated)}</>}
      </p>

      <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
        <dl class="space-y-3 text-[0.95rem]">
          <div><dt class="text-sm text-muted">{t.paths.audience}</dt><dd class="mt-0.5 text-ink-2">{p.audience[locale]}</dd></div>
          <div><dt class="text-sm text-muted">{t.paths.requires}</dt><dd class="mt-0.5 text-ink-2">{p.requires[locale]}</dd></div>
          <div><dt class="text-sm text-muted">{t.paths.outcome}</dt><dd class="mt-0.5 text-ink leading-relaxed">{p.outcome[locale]}</dd></div>
        </dl>

        {/* The one thing to do now. */}
        <div class="border border-ink-2 rounded-[4px] p-5 bg-paper-2">
          <p class="eyebrow">{t.paths.next}</p>
          {user && (
            <div class="mt-3">
              <p class="text-xs text-muted">{t.paths.progress(next.done, p.concepts.length)}</p>
              <div class="mt-1.5 h-1.5 rounded-full bg-rule overflow-hidden" role="progressbar" aria-valuemin={0} aria-valuemax={p.concepts.length} aria-valuenow={next.done} aria-label={t.paths.progress(next.done, p.concepts.length)}>
                <div class="h-full bg-e2" style={`width: ${(100 * next.done) / p.concepts.length}%`}></div>
              </div>
            </div>
          )}
          {finished ? (
            <p class="mt-3 text-sm text-ink-2 leading-relaxed">{t.paths.finished}</p>
          ) : (
            <>
              <p class="mt-3 display text-lg font-semibold">{t.paths.nextLine(next.index + 1, next.concept.title[locale])}</p>
              <p class="mt-1 text-sm text-ink-2">{next.concept.summary[locale]}</p>
              <a href={`/${locale}/concepts/${next.concept.slug}`} class="btn btn-primary btn-small mt-4 inline-flex">
                {next.done > 0 ? t.paths.continue : t.paths.start}
              </a>
              {minutes[next.concept.slug] && <span class="ml-3 text-xs text-muted">{t.paths.minutes(minutes[next.concept.slug])}</span>}
            </>
          )}
          {!user && <p class="mt-4 text-xs text-muted leading-relaxed">{t.paths.loginValue}</p>}
        </div>
      </div>
      <CreditLine credits={p.credits} class="mt-3" />

      <div class="mt-12 grid gap-12">
        <ol class="space-y-px bg-rule border border-rule">
          {p.concepts.map((slug, i) => {
            const c = getConcept(slug)!;
            const exps = experimentsForConcept(slug);
            const exs = exercisesForConcept(slug);
            const status = done[slug];
            return (
              <li class="bg-paper">
                <a href={`/${locale}/concepts/${slug}`} class="block p-6 hover:bg-paper-2 transition-colors">
                  <div class="flex items-baseline gap-4">
                    <span class={`mono ${status === "done" ? "text-e2" : "text-muted"}`}>{status === "done" ? "✓ " : ""}{String(i + 1).padStart(2, "0")}</span>
                    <h2 class="display text-xl font-semibold">{c.title[locale]}</h2>
                    {status && <span class="ml-auto text-xs text-leo">{t.learn.status[status as "learning" | "done"]}</span>}
                  </div>
                  <p class="mt-2 text-sm text-ink-2 pl-10">{c.summary[locale]}</p>
                  <p class="mt-3 text-xs mono text-muted pl-10">
                    {minutes[slug] ? `${t.learn.readingTime(minutes[slug])} · ` : ""}{t.paths.conceptCounts(exps.length, exs.length)}
                  </p>
                </a>
              </li>
            );
          })}
        </ol>
        <div>
          <p class="eyebrow mb-3">{t.learn.positionInTree}</p>
          <KnowledgeTree client:visible locale={locale} focus={p.concepts[p.concepts.length - 1]} minutes={minutes} />
        </div>
      </div>
    </div>

</Base>
